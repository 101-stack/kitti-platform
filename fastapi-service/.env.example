# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=INFO

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://kitti:kitti_pass@localhost:5432/kitti_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-very-long-random-secret-at-least-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Internal Security ────────────────────────────────────────────────────────
INTERNAL_API_KEY=change-me-internal-key

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NODE_SERVER_URL=http://localhost:4000

# ─── OTP / SMS ────────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# ─── Game Config ──────────────────────────────────────────────────────────────
GAME_ENTRY_FEE=100
NEW_USER_COINS=1000
