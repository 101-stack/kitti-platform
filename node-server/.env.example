# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-very-long-random-secret-at-least-64-chars

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── FastAPI Service ──────────────────────────────────────────────────────────
FASTAPI_URL=http://localhost:8000
INTERNAL_API_KEY=change-me-internal-key

# ─── Game Settings ────────────────────────────────────────────────────────────
GAME_ENTRY_FEE=100
SUBMIT_TIMEOUT_MS=60000
